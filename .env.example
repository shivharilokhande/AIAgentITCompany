# Directory where smartit.db is stored (created on first run)
DATA_DIR=./data
# Set to "0" to skip creating the demo project on first run
SEED_DEMO=1
PORT=3100

# ---- Engine bridge (all optional; the Configuration page overrides these) ----
# ENGINE_MODE=cowork            # cowork | api | ollama
# ANTHROPIC_API_KEY=            # CLAUDE_MODEL=claude-sonnet-5
# OPENAI_API_KEY=               # OPENAI_MODEL=gpt-5-codex
# GEMINI_API_KEY=               # GEMINI_MODEL=gemini-2.5-pro
# OPENROUTER_API_KEY=           # OPENROUTER_MODEL=qwen/qwen3-coder
# CUSTOM_LLM_BASE_URL=          # CUSTOM_LLM_API_KEY=  CUSTOM_LLM_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434   # OLLAMA_MODEL=qwen2.5-coder:14b
# LLM_TIMEOUT_MS=180000
# BRIDGE_TOKEN=                 # protect /api/bridge/* with a bearer token
# COWORK_WATCHER=1              # tail Claude Cowork session logs
